# rgb-sync: give the logged-in user access to the hidraw nodes of the RGB
# devices driven by rgb.py. Matched by USB vendor/product ID, so it follows the
# devices whenever their hidraw numbers change.
#
# uaccess is applied by 73-seat-late.rules, so this file must sort before it.

# Razer Firefly mouse mat
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1532", ATTRS{idProduct}=="0c00", TAG+="uaccess"

# ASUS Aura LED controller (motherboard)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0b05", ATTRS{idProduct}=="18f3", TAG+="uaccess"

# Corsair H115i Platinum AIO
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1b1c", ATTRS{idProduct}=="0c17", TAG+="uaccess"
